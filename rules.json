{
    "version": 4,
    "lastUpdated": "2026-07-01",
    "harmfulIngredients": [
        {
            "name": "palm oil",
            "reason": "~50% saturated fat; consensus flags LDL/CVD risk (not overturned by single review).",
            "source": "Harvard Health",
            "sourceUrl": "https://www.health.harvard.edu/healthy-aging-and-longevity/by_the_way_doctor_is_palm_oil_good_for_you",
            "penalty": 10
        },
        {
            "name": "high fructose corn syrup",
            "reason": "Fructose drives de novo lipogenesis, NAFLD, insulin resistance & dyslipidemia.",
            "source": "PMC narrative review",
            "sourceUrl": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8950441/",
            "penalty": 20
        },
        {
            "name": "corn syrup",
            "reason": "Glucose syrup / added sugar with high glycemic load; no exoneration found.",
            "source": "Harvard Health",
            "penalty": 15,
            "sourceUrl": "https://www.health.harvard.edu/staying-healthy/which-is-better-high-fructose-corn-syrup-or-table-sugar"
        },
        {
            "name": "hydrogenated",
            "reason": "Raises LDL, lowers HDL; PHOs banned by FDA (2018).",
            "source": "FDA Trans Fat",
            "sourceUrl": "https://www.fda.gov/food/food-additives-petitions/trans-fat",
            "penalty": 30
        },
        {
            "name": "red 40",
            "reason": "Behavioral effects in sensitive children.",
            "source": "FDA color additives report",
            "sourceUrl": "https://www.fda.gov/media/131378/download",
            "penalty": 15
        },
        {
            "name": "blue 1",
            "reason": "No exoneration found; kept as silence is not exoneration. Weaker basis (not in Southampton six).",
            "source": "Blue food coloring review",
            "sourceUrl": "https://pmc.ncbi.nlm.nih.gov/articles/PMC9573786/",
            "penalty": 8
        },
        {
            "name": "yellow 5",
            "reason": "Southampton-type behavioral effects + hypersensitivity.",
            "source": "FDA color additives report",
            "sourceUrl": "https://www.fda.gov/media/131378/download",
            "penalty": 15
        },
        {
            "name": "yellow 6",
            "reason": "Southampton behavioral basis.",
            "source": "FDA color additives report",
            "sourceUrl": "https://www.fda.gov/media/131378/download",
            "penalty": 15
        },
        {
            "name": "sucralose",
            "reason": "Metabolite sucralose-6-acetate shown genotoxic + intestinal/inflammatory effects.",
            "source": "PMC sweeteners review",
            "sourceUrl": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10817473/",
            "penalty": 12
        },
        {
            "name": "maltodextrin",
            "reason": "Digestible maltodextrin produces high glycemic response; no exoneration found.",
            "source": "PMC digestible maltodextrins",
            "sourceUrl": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4940893/",
            "penalty": 10
        },
        {
            "name": "sodium nitrite",
            "reason": "N-nitroso pathway; processed meat is IARC Group 1.",
            "source": "IARC Monographs",
            "sourceUrl": "https://publications.iarc.who.int/Book-And-Report-Series/Iarc-Monographs-On-The-Identification-Of-Carcinogenic-Hazards-To-Humans/Red-Meat-And-Processed-Meat-2018",
            "penalty": 25
        },
        {
            "name": "sodium nitrate",
            "reason": "Converts to nitrite; same N-nitroso carcinogenicity pathway.",
            "source": "IARC Monographs",
            "sourceUrl": "https://publications.iarc.who.int/Book-And-Report-Series/Iarc-Monographs-On-The-Identification-Of-Carcinogenic-Hazards-To-Humans/Red-Meat-And-Processed-Meat-2018",
            "penalty": 22
        },
        {
            "name": "titanium dioxide",
            "reason": "EFSA concluded E171 can no longer be considered safe; genotoxicity concern not ruled out.",
            "source": "EFSA Journal 2021",
            "sourceUrl": "https://www.efsa.europa.eu/en/efsajournal/pub/6585",
            "penalty": 20
        },
        {
            "name": "potassium bromate",
            "reason": "IARC Group 2B; flour improver; renal tumours in rats.",
            "source": "IARC Monographs (NCBI)",
            "sourceUrl": "https://www.ncbi.nlm.nih.gov/books/NBK402079/",
            "penalty": 25
        },
        {
            "name": "brominated vegetable oil",
            "reason": "FDA revoked authorization (final rule, effective Aug 2024) over bromine bioaccumulation.",
            "source": "FDA constituent update",
            "sourceUrl": "https://www.fda.gov/food/hfp-constituent-updates/fda-revokes-regulation-allowing-use-brominated-vegetable-oil-bvo-food",
            "penalty": 25
        },
        {
            "name": "tbhq",
            "reason": "No exoneration found; JECFA ADI 0.7 mg/kg basis retained.",
            "source": "WHO JECFA",
            "penalty": 12,
            "sourceUrl": "https://apps.who.int/food-additives-contaminants-jecfa-database/Home/Chemical/2098"
        },
        {
            "name": "red 3",
            "reason": "FDA revoked authorization Jan 2025 under the Delaney Clause (thyroid tumours in male rats).",
            "source": "FDA constituent update",
            "sourceUrl": "https://www.fda.gov/food/hfp-constituent-updates/fda-revoke-authorization-use-red-no-3-food-and-ingested-drugs",
            "penalty": 25
        },
        {
            "name": "propylparaben",
            "reason": "No exoneration found; EFSA endocrine/no-safe-ADI basis stands.",
            "source": "EFSA Opinion",
            "penalty": 15,
            "sourceUrl": "https://www.efsa.europa.eu/en/efsajournal/pub/1110"
        },
        {
            "name": "bha",
            "reason": "No exoneration found; NTP reasonably anticipated to be a human carcinogen.",
            "source": "NTP Report on Carcinogens",
            "penalty": 15,
            "sourceUrl": "https://ntp.niehs.nih.gov/sites/default/files/ntp/roc/content/profiles/butylatedhydroxyanisole.pdf"
        }
    ],
