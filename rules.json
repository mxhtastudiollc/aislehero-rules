{
    "version": 6,
    "lastUpdated": "2026-08-01",
    "harmfulIngredients": [
        {
            "name": "Red 40",
            "reason": "One of the Southampton dyes; linked in controlled trials to hyperactivity and attentional effects in sensitive children.",
            "source": "PMC (NIH)",
            "penalty": 15,
            "sourceUrl": "https://ncbi.nlm.nih.gov/pmc/articles/PMC3261955"
        },
        {
            "name": "Yellow 5",
            "reason": "Southampton study colour (tartrazine) tied to hyperactivity in children and to hypersensitivity reactions.",
            "source": "EFSA",
            "penalty": 15,
            "sourceUrl": "https://www.efsa.europa.eu/en/news/efsa-evaluates-southampton-study-food-additives-and-child-behaviour"
        },
        {
            "name": "Yellow 6",
            "reason": "Southampton study colour (sunset yellow) linked to behavioural effects in children.",
            "source": "EFSA",
            "penalty": 15,
            "sourceUrl": "https://www.efsa.europa.eu/en/news/efsa-evaluates-southampton-study-food-additives-and-child-behaviour"
        },
        {
            "name": "Red 3",
            "reason": "FDA revoked its authorization in food and ingested drugs under the Delaney Clause after cancer was found in male rats.",
            "source": "FDA 2025",
            "penalty": 20,
            "sourceUrl": "https://www.fda.gov/food/hfp-constituent-updates/fda-revoke-authorization-use-red-no-3-food-and-ingested-drugs"
        },
        {
            "name": "Aspartame",
            "reason": "Classified by IARC as Group 2B, possibly carcinogenic to humans, based on limited evidence.",
            "source": "IARC/WHO 2023",
            "penalty": 12,
            "sourceUrl": "https://www.iarc.who.int/news-events/aspartame-hazard-and-risk-assessment-results-released/"
        },
        {
            "name": "Sucralose",
            "reason": "Peer-reviewed genotoxicity concerns for its metabolite sucralose-6-acetate, alongside a WHO alert on non-sugar sweeteners.",
            "source": "PMC (NIH)",
            "penalty": 10,
            "sourceUrl": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10971371/"
        },
        {
            "name": "Sodium nitrite",
            "reason": "Used to cure processed meat, which IARC classifies Group 1 carcinogenic for colorectal cancer via N-nitroso compound formation.",
            "source": "WHO/IARC",
            "penalty": 18,
            "sourceUrl": "https://www.who.int/news-room/questions-and-answers/item/cancer-carcinogenicity-of-the-consumption-of-red-meat-and-processed-meat"
        },
        {
            "name": "Sodium nitrate",
            "reason": "Reduced to nitrite in the body, feeding the same N-nitroso pathway tied to the IARC Group 1 processed-meat cancer classification.",
            "source": "PMC (NIH)",
            "penalty": 18,
            "sourceUrl": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8388086/"
        },
        {
            "name": "Titanium dioxide",
            "reason": "EFSA concluded it can no longer be considered safe as a food additive due to genotoxicity concerns; banned in the EU.",
            "source": "EFSA 2021",
            "penalty": 16,
            "sourceUrl": "https://pubmed.ncbi.nlm.nih.gov/39100893/"
        },
        {
            "name": "Potassium bromate",
            "reason": "IARC Group 2B, possibly carcinogenic to humans, with sufficient animal evidence; banned in many countries.",
            "source": "WHO",
            "penalty": 18,
            "sourceUrl": "https://cdn.who.int/media/docs/default-source/wash-documents/wash-chemicals/bromate-backgound.pdf"
        },
        {
            "name": "Brominated vegetable oil",
            "reason": "FDA revoked the food-additive regulation in 2024, concluding it is no longer safe for use in food.",
            "source": "FDA 2024",
            "penalty": 16,
            "sourceUrl": "https://www.fda.gov/food/hfp-constituent-updates/fda-revokes-regulation-allowing-use-brominated-vegetable-oil-bvo-food"
        },
        {
            "name": "BHA",
            "reason": "Listed by the NTP as reasonably anticipated to be a human carcinogen, based on rodent forestomach tumours from dietary exposure.",
            "source": "NTP",
            "penalty": 14,
            "sourceUrl": "https://www.ncbi.nlm.nih.gov/books/NBK590883/"
        },
        {
            "name": "Propylparaben",
            "reason": "EFSA could not set a safe intake level due to effects on male reproductive organs in juvenile rats; no longer permitted in EU food.",
            "source": "EFSA",
            "penalty": 12,
            "sourceUrl": "https://www.efsa.europa.eu/en/news/efsa-advises-safety-paraben-usage-food"
        },
        {
            "name": "Sodium benzoate",
            "reason": "A core component of the Southampton study; combined with artificial colours it increased hyperactivity in children.",
            "source": "EFSA",
            "penalty": 10,
            "sourceUrl": "https://www.efsa.europa.eu/en/press/news/071212"
        },
        {
            "name": "Palm oil",
            "reason": "About 50% saturated fat, raising LDL cholesterol and cardiovascular risk.",
            "source": "Harvard Health",
            "penalty": 8,
            "sourceUrl": "https://www.health.harvard.edu/healthy-aging-and-longevity/by_the_way_doctor_is_palm_oil_good_for_you"
        },
        {
            "name": "High fructose corn syrup",
            "reason": "Concentrated free fructose linked to fatty liver disease, elevated triglycerides and insulin resistance at Western intakes.",
            "source": "NIH PubMed Central (Nutrients review, 2017)",
            "penalty": 12,
            "sourceUrl": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5622741/"
        },
        {
            "name": "Corn syrup",
            "reason": "High-glycemic glucose syrup that spikes blood sugar and adds to added-sugar load above recommended limits.",
            "source": "Harvard Health",
            "penalty": 8,
            "sourceUrl": "https://www.health.harvard.edu/staying-healthy/which-is-better-high-fructose-corn-syrup-or-table-sugar"
        },
        {
            "name": "hydrogenated",
            "reason": "Industrial trans fats that raise LDL and lower HDL with no safe intake level; PHOs banned by the FDA in 2018.",
            "source": "AHA Guidelines",
            "penalty": 20,
            "sourceUrl": "https://www.heart.org/en/healthy-living/healthy-eating/eat-smart/fats/trans-fat"
        },
        {
            "name": "Maltodextrin",
            "reason": "Highly processed high-glycemic starch that spikes blood glucose.",
            "source": "Medical News Today",
            "penalty": 6,
            "sourceUrl": "https://www.medicalnewstoday.com/articles/322426"
        },
        {
            "name": "TBHQ",
            "reason": "Preservative with animal-study toxicological concerns above the established safe intake level.",
            "source": "WHO JECFA",
            "penalty": 8,
            "sourceUrl": "https://apps.who.int/food-additives-contaminants-jecfa-database/Home/Chemical/2098"
        }
    ],
    "thresholds": {
        "sugar": {
            "dailyLimitMen": 36,
            "dailyLimitWomen": 25,
